<Window x:Class="Xiaoliu.App.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False">
    <!-- 常驻胶囊：屏幕上唯一的「我在」标记。没有它，用户不知道小柳在不在。 -->
    <Border CornerRadius="14" Padding="10,5" Cursor="Hand"
            MouseLeftButtonUp="OnPillClick">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F5292B30" Offset="0" />
                <GradientStop Color="#F21A1C20" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                     VerticalAlignment="Center" Margin="0,0,7,0">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.35" Duration="0:0:1.4" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <TextBlock x:Name="Label" Text="小柳" FontSize="12" Foreground="#FFE8EAEF"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="Status" Text="" FontSize="12" Foreground="{StaticResource MutedText}"
                       VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>
    </Border>
</Window>
