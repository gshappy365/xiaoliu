<Window x:Class="Xiaoliu.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小柳 · 历史" Height="640" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#FF14161C" Foreground="#FFE8EAF0" FontSize="13">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Foreground="#FFB9BCC4" />
            <Button Content="刷新" Click="OnRefresh" Margin="16,0,0,0" Padding="14,4" />
            <Button Content="清空历史" Click="OnClear" Margin="8,0,0,0" Padding="14,4" />
        </StackPanel>

        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#FF1B1E26" Foreground="#FFE8EAF0" RowBackground="#FF1B1E26"
                  AlternatingRowBackground="#FF20232C" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#FF2C303B" BorderBrush="#FF2C303B"
                  HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt, StringFormat='MM-dd HH:mm'}" Width="110" />
                <DataGridTextColumn Header="问题" Binding="{Binding Question}" Width="300" />
                <DataGridTextColumn Header="回答" Binding="{Binding Answer}" Width="*" />
                <DataGridTextColumn Header="截图" Binding="{Binding ScreenshotCount}" Width="60" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
