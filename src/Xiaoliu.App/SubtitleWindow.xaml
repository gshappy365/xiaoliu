<Window x:Class="Xiaoliu.App.SubtitleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="Height" Width="760" Focusable="False">
    <Border Background="{StaticResource PanelBackground}" CornerRadius="16" Padding="20,14" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedText}" FontSize="12"
                       Margin="2,0,0,6" Text="小柳" />
            <TextBlock x:Name="BodyText" Foreground="White" FontSize="20" LineHeight="30"
                       TextWrapping="Wrap" MaxHeight="120" />
        </StackPanel>
    </Border>
</Window>
